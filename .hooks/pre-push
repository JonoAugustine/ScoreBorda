#!/usr/bin/env bash
set -uo pipefail

echo 'Pre-Push Hook'

# Check the commits being pushed, not the index. The index is normally empty by push
# time, so the old `--staged` diff made this hook a guaranteed no-op on a clean tree.
if UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
  RANGE="$UPSTREAM...HEAD"
else
  # First push of a branch: no upstream to compare against, so use the default branch.
  RANGE="origin/master...HEAD"
fi

FILES=$(git diff --name-only --diff-filter=d "$RANGE" -- '*.ts' '*.tsx')

if [ -z "$FILES" ]; then
  echo "No sourcecode changes in $RANGE. Skipping linter and formatter."
  exit 0
fi

echo "Checking files changed in $RANGE:"
echo "$FILES"

pnpm eslint $FILES || exit 1

printf '\n----------------------\n\n'
echo 'Checking formatting:'
pnpm prettier --config .prettierrc.yaml -c $FILES || exit 1
