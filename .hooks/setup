#!/usr/bin/env bash
set -euo pipefail

# Point git at .hooks directly rather than copying into .git/hooks. Copies go stale the
# moment a hook is edited, and the old `cp "$SCRIPT_DIR/pre-commit" .git/hooks` only
# worked when the script happened to be run from the repo root.
cd "$(git rev-parse --show-toplevel)"
git config core.hooksPath .hooks

echo "core.hooksPath -> .hooks"
